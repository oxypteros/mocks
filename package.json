{
	"name": "mocks",
	"private": true,
	"version": "0.0.4",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && node scripts/strip-global-props.mjs && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && node scripts/strip-global-props.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:a11y": "playwright test e2e/a11y.e2e.ts",
		"gen": "wrangler types",
		"db:studio": "drizzle-kit studio --config=drizzle.remote.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply mocks-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply mocks-db --remote",
		"db:seed:mocks:local": "wrangler d1 execute mocks-db --local --file=./scripts/seed-mocks.sql",
		"db:seed:mocks:remote": "wrangler d1 execute mocks-db --remote --file=./scripts/seed-mocks.sql",
		"db:seed:demo:local": "wrangler d1 execute mocks-db --local --file=./scripts/seed-demo.sql",
		"bank:validate": "node scripts/bank/validate.ts",
		"bank:length-audit": "node scripts/bank/length-audit.ts",
		"bank:link-check": "node scripts/bank/link-check.ts",
		"bank:build": "node scripts/bank/build.ts",
		"bank:seed:local": "node scripts/bank/seed.ts --local",
		"bank:seed:remote": "node scripts/bank/seed.ts --remote",
		"bank:preview:local": "pnpm run bank:seed:local && pnpm run db:publish:exam:local",
		"db:publish:exam:local": "wrangler d1 execute mocks-db --local --file=./scripts/publish-exam-local.sql"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^5.1.0",
		"axe-core": "^4.14.0",
		"bits-ui": "^2.20.4",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.157.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
